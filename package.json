{
  "name": "euro-tour-html-css",
  "version": "1.0.0",
  "private": true,
  "description": "Development checks for the EuroTour static website",
  "license": "MIT",
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\" --max-warnings 0"
  },
  "devDependencies": {
    "html-validate": "11.16.2",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0"
  }
}
